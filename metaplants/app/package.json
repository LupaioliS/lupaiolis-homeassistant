{
	"name": "metaplants",
	"version": "1.5.0",
	"description": "Plant manager for Home Assistant",
	"homepage": "https://github.com/LupaioliS/lupaiolis-homeassistant#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LupaioliS/lupaiolis-homeassistant.git"
	},
	"license": "ISC",
	"author": "LupaioliS",
	"scripts": {
		"build:server": "tsc -p tsconfig.server.json",
		"build:client": "vite build",
		"build": "npm run build:server && npm run build:client",
		"dev:server": "tsx watch src/server/index.ts",
		"dev:client": "vite",
		"dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
		"start": "node dist/server/index.js"
	},
	"dependencies": {
		"@fastify/cors": "^10.0.0",
		"@fastify/multipart": "^9.4.0",
		"@fastify/static": "^8.1.0",
		"dotenv": "^17.4.2",
		"fastify": "^5.3.0",
		"mqtt": "^5.10.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"@vitejs/plugin-react": "^4.4.0",
		"concurrently": "^9.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"vite": "^6.3.0"
	}
}
